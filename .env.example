# The app runs without API keys in local demo mode.
PORT=3000
HOST=127.0.0.1
CORD_DEMO=1
CORD_OPEN_SIGNUP=0
# Optional override; otherwise generated once in ignored data/master.key.
# Back up the master key together with the database.
# CORD_MASTER_KEY=generated_64_hex_digits
# Set to 1 behind HTTPS reverse proxy.
CORD_SECURE_COOKIE=0
# Only allow agent connector origins that you trust in production.
# CORD_AGENT_ALLOWED_HOSTS=api.openai.com,api.example.com
# Public HTTPS URL reachable by remote agent computers.
# CORD_PUBLIC_ORIGIN=https://cord.example.com
# To create an empty real workspace, set CORD_DEMO=0 and a fresh DB path.
# CORD_DB_PATH=data/production.db
