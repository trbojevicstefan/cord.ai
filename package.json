{
  "name": "cord-ai",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Thread-first collaboration for teams and AI agents",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "dev": "node --watch --disable-warning=ExperimentalWarning server/index.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "npm run check",
    "bridge": "node bridge/runner.cjs"
  },
